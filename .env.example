VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here
VITE_GM10_LAST_KNOWN_CATCH_PRICE_USD=
POLYGON_RPC_URL=https://polygon.drpc.org
MOBULA_API_KEY=

# Admin valuation provider adapters
POKEMON_PRICE_TRACKER_API_KEY=
# Card identity changes too often for env vars. Discovery uses registry/admin metadata
# and optional request-time cardIdentityOverrides when a job needs manual identity hints.

# Admin Courtyard deal scanner.
# Use one of these to point the wizard at a self-hosted JSON catalog feed.
COURTYARD_DEALS_CATALOG_URL=
OPENSEA_API_KEY=
COURTYARD_OPENSEA_COLLECTION_SLUG=courtyard-nft
COURTYARD_OPENSEA_CONTRACT=0x251be3a17af4892035c37ebf5890f4a4d889dcAD
COURTYARD_OPENSEA_CHAIN=matic
COURTYARD_OPENSEA_PAGE_LIMIT=50
COURTYARD_OPENSEA_MAX_PAGES=2
COURTYARD_CATALOG_START_URLS=
COURTYARD_CATALOG_MAX_PAGES=100
COURTYARD_CATALOG_MAX_DEPTH=2
COURTYARD_CATALOG_SAME_ORIGIN=true
COURTYARD_CATALOG_RESPECT_ROBOTS=true

# EVA Token Gate
VITE_EVA_TOKEN_ADDRESS=0x6Ae3b236d5546369db49AFE3AecF7e32c5F27672
VITE_MIN_EVA_HOLD=10000000
VITE_EVA_CHAIN_ID=43114  # Always read $EVA balance from Avalanche mainnet
