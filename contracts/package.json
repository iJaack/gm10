{
  "name": "gm10-contracts",
  "version": "1.0.0",
  "description": "GM10 Smart Contracts - Avalanche C-Chain",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:fuji": "hardhat run scripts/deployProxy.js --network fuji",
    "deploy:mainnet": "hardhat run scripts/deployProxy.js --network avalanche",
    "deploy:proxy:fuji": "hardhat run scripts/deployProxy.js --network fuji",
    "deploy:proxy:mainnet": "hardhat run scripts/deployProxy.js --network avalanche",
    "deploy:oft:fuji": "hardhat run scripts/deployOftAdapter.js --network fuji",
    "deploy:oft:mainnet": "hardhat run scripts/deployOftAdapter.js --network avalanche",
    "upgrade:proxy:fuji": "hardhat run scripts/upgradeProxy.js --network fuji",
    "upgrade:proxy:mainnet": "hardhat run scripts/upgradeProxy.js --network avalanche",
    "create:test-round:fuji": "hardhat run scripts/createTestRoundFuji.js --network fuji",
    "grant:purchase-roles:fuji": "hardhat run scripts/grantPurchaseTestRolesFuji.js --network fuji",
    "purchase:test:fuji": "hardhat run scripts/testPurchaseFlowFuji.js --network fuji",
    "purchase:resume:fuji": "hardhat run scripts/resumePurchaseFlowFuji.js --network fuji",
    "revoke:purchase-roles:fuji": "hardhat run scripts/revokePurchaseTestRolesFuji.js --network fuji",
    "repair:legacy-storage:fuji": "hardhat run scripts/repairLegacyStorageUpgrade.js --network fuji",
    "repair:legacy-storage:mainnet": "hardhat run scripts/repairLegacyStorageUpgrade.js --network avalanche",
    "repair:investor-tracking:mainnet": "hardhat run scripts/repairInvestorTrackingStorage.js --network avalanche",
    "migrate:registry-v2:fuji": "hardhat run scripts/migratePortfolioRegistryV2.js --network fuji",
    "migrate:registry-v2:mainnet": "hardhat run scripts/migratePortfolioRegistryV2.js --network avalanche",
    "verify:fuji": "hardhat run scripts/verify.js --network fuji",
    "verify:mainnet": "hardhat run scripts/verify.js --network avalanche",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@layerzerolabs/oft-evm": "^4.0.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-ledger": "^1.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.0.1",
    "@openzeppelin/contracts-upgradeable": "^5.0.1",
    "@openzeppelin/hardhat-upgrades": "^3.0.5",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "dotenv": "^16.3.1",
    "hardhat": "^2.19.4",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.17",
    "ts-node": "^10.9.2"
  },
  "keywords": [
    "avalanche",
    "solidity",
    "smart-contract",
    "pokemon",
    "tokenization",
    "defi"
  ],
  "license": "MIT"
}
